# LughaLLM — Environment Configuration Template
# Copy to .env and populate only the credentials needed for your deployment target.
# Without external keys, LughaLLM runs in local/offline orchestration mode.

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEFAULT_MODEL=lughallm-llama3-8b

# Local Ollama / vLLM Inference Bridge (Optional)
LUGHALLM_LOCAL_URL=http://localhost:11434
LUGHALLM_LOCAL_MODEL=llama3:8b

# NVIDIA NIM / Cloud Inference (Optional)
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# Google Cloud / Vertex AI (Optional)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_VERTEX_ENDPOINT=

# M-Pesa Daraja Mobile Money Billing (Optional — defaults to sandbox shortcode)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379

# WhatsApp Audio Webhook Verification (Optional)
WHATSAPP_VERIFY_TOKEN=
